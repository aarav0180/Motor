[Unit]
Description=VibraGuard Motor Condition Monitor (Tier 1 Edge Daemon)
Documentation=https://github.com/your-username/ESI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ESI
ExecStart=/home/pi/ESI/venv/bin/python3 -m service.monitor
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
